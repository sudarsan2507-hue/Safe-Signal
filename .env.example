# SafeSignal backend — optional.
#
# The app works with none of this set: the check-in timer runs on-device and
# prepares a message you send yourself. Filling these in adds the one thing a
# browser cannot do — dispatching the alert with no help from your phone, so it
# still goes out if you are unable to act.
#
# Copy to .env.local for local work, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# ── Where this deployment lives ────────────────────────────────────────────
# Used to build the callback URL the scheduler calls back on. No trailing slash.
PUBLIC_BASE_URL=https://safe-signal-pi.vercel.app

# ── Secret used to sign check-in tokens ────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every check-in currently in flight.
CHECKIN_SIGNING_SECRET=

# ── Upstash Redis (stores check-ins) ───────────────────────────────────────
# upstash.com → Redis → create database → REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upstash QStash (calls us back when a check-in expires) ─────────────────
# upstash.com → QStash → the token is on the dashboard
QSTASH_TOKEN=

# ── Which provider actually places the call and sends the text ─────────────
# One of: console | twilio | exotel
# "console" logs instead of sending — safe for local testing, and the default
# so a half-configured deployment can never silently fail to reach anyone.
MESSAGING_PROVIDER=console

# ── Twilio (global) ────────────────────────────────────────────────────────
# Note: automated voice calls to Indian numbers need a regulatory bundle, and
# India's DND registry restricts them. Consider Exotel for domestic numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Exotel (India) ─────────────────────────────────────────────────────────
# Handles Indian telecom compliance more smoothly than Twilio does.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
# Exotel connects a call to a flow (applet) rather than reading text aloud.
# Create a flow that plays your message and put its URL here.
EXOTEL_FLOW_URL=
